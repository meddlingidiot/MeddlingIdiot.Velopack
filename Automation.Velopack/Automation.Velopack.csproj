<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <IsPackable>true</IsPackable>
        <Title>Velopack Bootstrapper</Title>
        <TargetFramework>net10.0</TargetFramework>

        <!-- ── Packaging ────────────────────────────────────────────────────
             The package id is MeddlingIdiot.*, the assembly and namespaces are Automation.*,
             and that is the house convention rather than an oversight: MeddlingIdiot names
             products, Automation names the build and release plumbing behind them. Fallout's
             components are shaped the same way.

             The id had to move regardless of that. The work repository this was forked from
             still publishes Automation.Velopack to its own feed, and one id served by two
             feeds from two diverged codebases resolves to whichever version number is
             higher - silently, and differently per machine.
        -->
        <PackageId>MeddlingIdiot.Velopack</PackageId>
        <Description>Velopack startup and update plumbing for MeddlingIdiot desktop apps: channel resolution, the update check, and the version information an app shows about itself.</Description>
        <PackageTags>velopack;update;desktop;installer;squirrel</PackageTags>
        <Authors>MeddlingIdiot</Authors>
        <Company>MeddlingIdiot</Company>
        <Copyright>Copyright © MeddlingIdiot</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/meddlingidiot/MeddlingIdiot.Velopack</PackageProjectUrl>
        <RepositoryUrl>https://github.com/meddlingidiot/MeddlingIdiot.Velopack</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
         <PackageReference Include="Velopack" Version="1.2.0" />
    </ItemGroup>

</Project>
