<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org only. The GitHub Packages feed went with the rename: everything this repository
  needs is public now, and a private feed in the list makes a clone fail to restore for a
  reason that has nothing to do with the build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
